\section{Konu Anlatımı ve Teorik Altyapı}

\begin{konubox}[title=\faBook\enspace 1. Tamlık Bölgesi]
Bir halkadan alınan $x$ ve $y$ elemanları için, $x \cdot y = 0$ iken $x = 0$ VEYA $y = 0$ şartı sağlanıyorsa (sıfır bölen yoksa), bu yapıya \textbf{Tamlık Bölgesi} denir.\\
\textbf{Kritik Teorem:} Bir tamlık bölgesinde 0 ve 1 elemanlarından başka karesi kendisine eşit olan ($e^2=e$) idempotent eleman bulunamaz.
\end{konubox}

\begin{konubox}[title=\faBook\enspace 2. İdeallik]
Bir alt kümenin ideal olabilmesi için iki şart vardır:
\begin{itemize}
    \item Toplamsal alt grup olması.
    \item \textbf{Yutma özelliği:} Dışarıdan bir elemanla çarpıldığında sonucu içeri çekmesi gerekir ($r \in R, a \in I \Rightarrow r \cdot a \in I$).
\end{itemize}
\end{konubox}

\begin{konubox}[title=\faBook\enspace 3. Maksimal ve Asal İdealler]
\textbf{Maksimal İdeal:} İdeallerin en büyüğüdür. $\mathbf{R/M}$ \textbf{bir cisimdir} $\iff$ \textbf{M maksimaldir}.\\
\textbf{Asal İdeal:} $a \cdot b \in P \Rightarrow a \in P$ veya $b \in P$ şartını sağlayan idealdir. $\mathbf{R/P}$ \textbf{bir tamlık bölgesidir} $\iff$ \textbf{P asaldır}.\\
Her maksimal ideal asaldır, fakat her asal ideal maksimal olmak zorunda değildir.
\end{konubox}

\begin{konubox}[title=\faBook\enspace 4. UFD, PID ve Öklid Bölgesi]
\textbf{UFD (Tek Türlü Çarpanlara Ayrılma Bölgesi):} Çarpanlara ayırmanın asal çarpanlar seviyesinde tek türlü olduğu yapılardır ($\mathbb{Z}$ gibi). $\mathbb{Z}[\sqrt{-5}]$ bir UFD değildir.\\
\textbf{PID (Temel İdeal Bölgesi):} Tüm idealleri tek bir üreteç elemanla üretilebilen bölgelerdir. Her PID bir UFD'dir.\\
\textbf{Öklid Bölgesi:} Elemanların büyüklüğünü (normunu) ölçebildiğimiz ve kalanlı bölme algoritması yapabildiğimiz bölgelerdir.
\\
\textbf{Hiyerarşi:} Öklid Bölgesi $\subset$ PID $\subset$ UFD $\subset$ Tamlık Bölgesi.
\end{konubox}

\begin{konubox}[title=\faBook\enspace 5. Polinomlarda İndirgenemezlik Testleri]
\textbf{Rasyonel Kök Kriteri:} Kök $r/s$ formundaysa $r$ sabit terimi, $s$ başkatsayıyı bölmelidir.\\
\textbf{Eisenstein Kriteri:} Bir $p$ asalı başkatsayıyı bölmemeli, diğerlerini bölmeli, karesi sabit terimi bölmemeli.\\
\textbf{Mod-p Testi:} Polinomu katsayılarıyla birlikte $\mathbb{Z}_p$ sonlu cismine indirgeyip orada kök arama işlemidir. Eğer polinom $\mathbb{Z}_p$'de indirgenemez çıkarsa (ve derecesi korunuyorsa), rasyonel sayılar cismi $\mathbb{Q}$ üzerinde de kesinlikle indirgenemezdir.
\end{konubox}

